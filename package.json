{
  "name": "mob1s-carbon-telemetry",
  "private": true,
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "type-check": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build && node scripts/copy-legacy.mjs && node scripts/verify-site.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node tests/browser-smoke.cjs",
    "admin": "node admin/server.js",
    "server": "node server.js",
    "start": "node server.js"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "animejs": "4.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "multer": "^2.2.0",
    "three": "0.160.0",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/three": "0.160.0",
    "@vitejs/plugin-vue": "6.0.2",
    "playwright": "1.62.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vue-tsc": "3.1.4"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
